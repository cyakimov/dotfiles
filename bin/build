#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

[[ $# -eq 0 ]] || die "Usage: bin/build"
require_apple_silicon_macos
load_nix_environment
require_command nix
[[ -f $DOTFILES_ROOT/flake.lock ]] || die "flake.lock is missing. Generate and review it before building."

say "Checking the locked flake without changing the system..."
nix flake check --no-write-lock-file "$DOTFILES_ROOT"

say "Building the nix-darwin system without creating a result link..."
nix build --no-link --print-out-paths "$DOTFILES_ROOT#darwinConfigurations.shared-macos.system"

say "Build completed. Nothing was activated."
