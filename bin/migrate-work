#!/usr/bin/env bash

set -euo pipefail

umask 077

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
state_root=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-work-migration
backup_root=$state_root/backup
brewfile=$state_root/work.Brewfile
command_name=${1:-help}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

usage() {
  cat <<'EOF'
Usage: bin/migrate-work <command>

Commands:
  audit     Inventory the pre-Nix work laptop without changing managed paths
  prepare   Install prerequisites and preserve files that activation will replace
  activate  Build and activate the work profile after a Time Machine snapshot
  verify    Verify the active work profile from a fresh login shell
  cleanup   Permanently remove the confirmed legacy package-manager state
  restore   Restore preserved files before a successful activation
  help      Show this help

Run the commands in order. State and recoverable backups are kept in:
  ~/.local/state/dotfiles-work-migration
EOF
}

[[ $# -le 1 ]] || die "Usage: bin/migrate-work <audit|prepare|activate|verify|cleanup|restore|help>"

case $command_name in
  audit | prepare | activate | verify | cleanup | restore | help) ;;
  *) die "Usage: bin/migrate-work <audit|prepare|activate|verify|cleanup|restore|help>" ;;
esac

if [[ $command_name == help ]]; then
  usage
  exit 0
fi

[[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] || \
  die "This migration supports Apple Silicon macOS only."
[[ $(id -un) == cyakimov ]] || die "This migration expects the macOS user cyakimov."
[[ $HOME == /Users/cyakimov ]] || die "This migration expects HOME=/Users/cyakimov."

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

[[ ! -e $state_root || -d $state_root ]] || die "Migration state must be a directory: $state_root"
[[ ! -L $state_root ]] || die "Migration state must not be a symbolic link: $state_root"
if [[ -d $state_root && ! -f $state_root/revision ]] && \
  [[ -n $(find "$state_root" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
  die "Unrecognized migration state exists without a revision marker: $state_root"
fi
for state_path in "$backup_root" "$backup_root/home" "$backup_root/system"; do
  [[ ! -L $state_path ]] || die "Migration state path must not be a symbolic link: $state_path"
done
mkdir -p "$state_root" "$backup_root/home" "$backup_root/system"
chmod 700 "$state_root" "$backup_root" "$backup_root/home" "$backup_root/system"

require_clean_repo() {
  [[ -z $(git -C "$root" status --porcelain --untracked-files=normal) ]] || \
    die "Refusing to continue from a dirty checkout."
}

current_revision() {
  git -C "$root" rev-parse HEAD
}

record_revision() {
  local revision
  revision=$(current_revision)
  if [[ -f $state_root/revision ]]; then
    [[ $(<"$state_root/revision") == "$revision" ]] || \
      die "Migration state belongs to another repository revision."
  else
    printf '%s\n' "$revision" >"$state_root/revision"
  fi
}

require_marker() {
  [[ -f $state_root/$1 ]] || die "Run bin/migrate-work $2 first."
}

confirm() {
  local expected=$1
  local answer
  printf 'Type %s to continue: ' "$expected" >/dev/tty
  IFS= read -r answer </dev/tty || die "Could not read confirmation."
  [[ $answer == "$expected" ]] || die "Confirmation did not match."
}

load_nix() {
  if ! command -v nix >/dev/null 2>&1 && \
    [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    set +u
    # shellcheck disable=SC1091
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
    set -u
  fi
  command -v nix >/dev/null 2>&1 || die "Nix is unavailable after bootstrap. Open a new shell and rerun prepare."
}

hash_mutable_settings() {
  local output=$1
  local relative path hash
  : >"$output"
  for relative in \
    .claude/settings.json \
    .codex/config.toml \
    .pi/agent/settings.json; do
    path=$HOME/$relative
    if [[ -f $path ]]; then
      hash=$(shasum -a 256 "$path" | awk '{ print $1 }')
    else
      hash=MISSING
    fi
    printf '%s\t%s\n' "$hash" "$path" >>"$output"
  done
}

inventory_path() {
  local path=$1
  if [[ -e $path || -L $path ]]; then
    du -sh "$path" 2>/dev/null || ls -ld "$path"
  fi
}

audit() {
  local found_mise=false
  local path

  [[ ! -f $state_root/prepared ]] || die "The migration is already prepared. Continue with activate."
  require_clean_repo
  record_revision

  {
    printf 'revision\t%s\n' "$(current_revision)"
    printf 'date\t%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'macOS\t%s\n' "$(sw_vers -productVersion)"
    printf 'architecture\t%s\n' "$(uname -m)"
  } >"$state_root/system.tsv"

  if command -v brew >/dev/null 2>&1; then
    brew list --formula >"$state_root/homebrew-formulae.txt"
    brew list --cask >"$state_root/homebrew-casks.txt"
    brew tap >"$state_root/homebrew-taps.txt"
  else
    : >"$state_root/homebrew-formulae.txt"
    : >"$state_root/homebrew-casks.txt"
    : >"$state_root/homebrew-taps.txt"
    note "Homebrew is not installed."
  fi

  : >"$state_root/manual-brewfiles.txt"
  find "$HOME" -maxdepth 3 -type f -name Brewfile -print \
    >"$state_root/manual-brewfiles.txt" 2>/dev/null || true

  : >"$state_root/mise-tools.txt"
  if command -v mise >/dev/null 2>&1; then
    found_mise=true
    mise list >"$state_root/mise-tools.txt" 2>&1 || true
  fi

  : >"$state_root/project-runtime-files.txt"
  if [[ -d $HOME/Development ]]; then
    find "$HOME/Development" -maxdepth 6 -type f \
      \( -name mise.toml -o -name .mise.toml -o -name .tool-versions \) \
      -print >"$state_root/project-runtime-files.txt" 2>/dev/null || true
  fi

  : >"$state_root/legacy-paths.txt"
  for path in \
    "$HOME/.config/mise" \
    "$HOME/.local/share/mise" \
    "$HOME/.local/state/mise" \
    "$HOME/.cache/mise" \
    "$HOME/.asdf" \
    "$HOME/.rtx" \
    "$HOME/.nvm" \
    "$HOME/.rbenv" \
    "$HOME/.pyenv" \
    "$HOME/.nodenv" \
    "$HOME/.local/pipx" \
    "$HOME/.local/share/pipx" \
    "$HOME/.cache/pipx" \
    "$HOME/.bun/install/cache" \
    "$HOME/.cargo/registry" \
    "$HOME/.cargo/git" \
    "$HOME/.config/herdr" \
    "$HOME/.local/bin/mise" \
    "$HOME/.local/bin/herdr"; do
    inventory_path "$path" >>"$state_root/legacy-paths.txt"
  done

  : >"$state_root/legacy-shell-references.txt"
  for path in \
    "$HOME/.bash_profile" \
    "$HOME/.bashrc" \
    "$HOME/.profile" \
    "$HOME/.zlogin" \
    "$HOME/.zprofile" \
    "$HOME/.zshenv" \
    "$HOME/.zshrc"; do
    if [[ -f $path ]]; then
      grep -nEi 'mise|rtx|asdf|pyenv|rbenv|nodenv|nvm' "$path" \
        >>"$state_root/legacy-shell-references.txt" 2>/dev/null || true
    fi
  done

  : >"$state_root/managed-home-paths.txt"
  for path in \
    "$HOME/.bashrc" \
    "$HOME/.profile" \
    "$HOME/.zprofile" \
    "$HOME/.zshenv" \
    "$HOME/.zshrc" \
    "$HOME/.gitconfig" \
    "$HOME/.tmux.conf" \
    "$HOME/.config" \
    "$HOME/.claude" \
    "$HOME/.codex" \
    "$HOME/.pi"; do
    if [[ -e $path || -L $path ]]; then
      ls -ld "$path" >>"$state_root/managed-home-paths.txt"
    fi
  done

  hash_mutable_settings "$state_root/mutable-settings.before.tsv"

  note "Audit saved to $state_root"
  note "Legacy paths:"
  if [[ -s $state_root/legacy-paths.txt ]]; then
    sed 's/^/  /' "$state_root/legacy-paths.txt"
  else
    note "  none"
  fi
  if $found_mise; then
    note "Mise tools:"
    sed 's/^/  /' "$state_root/mise-tools.txt"
  fi
  if [[ -s $state_root/project-runtime-files.txt ]]; then
    note "Project runtime files will be preserved:"
    sed 's/^/  /' "$state_root/project-runtime-files.txt"
  fi
  if command -v herdr >/dev/null 2>&1 || [[ -e $HOME/.config/herdr ]]; then
    note "Herdr was detected and will be treated as forbidden legacy work state."
  fi

  touch "$state_root/audited"
  note "Audit completed. Run bin/migrate-work prepare."
}

validate_work_identity() {
  local identity=$HOME/.config/git/work.inc
  local name email signing_key

  [[ -f $identity && ! -L $identity ]] || die "Work identity must be a regular file: $identity"
  name=$(git config --file "$identity" --get user.name || true)
  email=$(git config --file "$identity" --get user.email || true)
  signing_key=$(git config --file "$identity" --get user.signingkey || true)
  [[ -n $name && $name != "Your Name" ]] || die "Set the work user.name in $identity"
  [[ -n $email && $email != *company.example* ]] || die "Set the work user.email in $identity"
  [[ -n $signing_key && $signing_key != *REPLACE_ME* ]] || die "Set the work SSH signing key in $identity"
  chmod 600 "$identity"
}

prepare_work_identity() {
  local identity=$HOME/.config/git/work.inc
  if [[ ! -e $identity ]]; then
    mkdir -p "$HOME/.config/git"
    cp "$root/config/git/work.inc.example" "$identity"
    chmod 600 "$identity"
    note "Created $identity"
    die "Fill in the work identity and rerun prepare."
  fi
  validate_work_identity
}

generate_brewfile() {
  nix --extra-experimental-features "nix-command flakes" \
    eval --raw --no-write-lock-file \
    "$root#darwinConfigurations.work.config.homebrew.brewfile" >"$brewfile"
}

preview_homebrew_cleanup() {
  local output=$1
  command -v brew >/dev/null 2>&1 || die "Homebrew is unavailable."
  generate_brewfile
  note "Homebrew cleanup preview:"
  brew bundle cleanup --file="$brewfile" 2>&1 | tee "$output"
}

backup_key() {
  printf '%s' "$1" | shasum -a 256 | awk '{ print $1 }'
}

is_nix_link() {
  local target=$1
  local link
  [[ -L $target ]] || return 1
  link=$(readlink "$target")
  [[ $link == *'/nix/store/'* || $link == *'home-manager-files'* || $link == '/etc/static/'* ]]
}

move_home_path() {
  local target=$1
  local mode=${2:-moved}
  local key backup

  [[ -e $target || -L $target ]] || return 0
  is_nix_link "$target" && return 0
  key=$(backup_key "$target")
  backup=$backup_root/home/$key

  if [[ -e $backup || -L $backup ]]; then
    [[ ! -e $target && ! -L $target ]] || die "Both migration source and backup exist: $target"
    if ! awk -F '\t' -v target="$target" '$1 == target { found = 1 } END { exit !found }' \
      "$state_root/moved-home.tsv"; then
      printf '%s\t%s\t%s\n' "$target" "$backup" "$mode" >>"$state_root/moved-home.tsv"
    fi
    return 0
  fi

  mv "$target" "$backup"
  printf '%s\t%s\t%s\n' "$target" "$backup" "$mode" >>"$state_root/moved-home.tsv"
  note "Preserved $target"
}

unfold_parent() {
  local target=$1
  local link source key backup marker

  key=$(backup_key "$target")
  backup=$backup_root/home/$key
  marker=$state_root/unfolded-$key

  if [[ ! -L $target && -f $marker ]]; then
    return 0
  fi
  if [[ ! -L $target && ! -L $backup ]]; then
    mkdir -p "$target"
    return 0
  fi
  if [[ -L $target ]]; then
    is_nix_link "$target" && die "Managed parent directory is unexpectedly a Nix link: $target"
    link=$(readlink "$target")
  else
    link=$(readlink "$backup")
  fi

  if [[ $link == /* ]]; then
    source=$link
  else
    source=$(CDPATH='' cd -- "$(dirname -- "$target")/$link" && pwd -P)
  fi
  [[ -d $source ]] || die "Symbolic-link parent does not resolve to a directory: $target"

  if [[ -L $target ]]; then
    move_home_path "$target" unfolded
  fi
  mkdir -p "$target"
  if [[ ! -f $marker ]]; then
    /usr/bin/ditto "$source" "$target"
    touch "$marker"
    note "Unfolded $target without modifying $source"
  fi
}

preserve_home_paths() {
  local relative

  touch "$state_root/moved-home.tsv"
  for relative in .config .claude .codex .pi .docker; do
    unfold_parent "$HOME/$relative"
  done

  for relative in \
    .bash_profile \
    .bashrc \
    .profile \
    .zlogin \
    .zprofile \
    .zshenv \
    .zshrc \
    .p10k.zsh \
    .zsh_aliases \
    .tmux.conf \
    .gitconfig \
    .gitignore_global \
    .config/git/personal.inc \
    .config/ghostty/config \
    .config/herdr \
    .config/wezterm \
    .claude/CLAUDE.md \
    .claude/statusline-command.sh \
    .codex/AGENTS.md \
    .pi/agent/AGENTS.md \
    .pi/agent/keybindings.json \
    .docker/cli-plugins/docker-compose; do
    move_home_path "$HOME/$relative"
  done
}

prepare_system_shell_files() {
  local target backup link
  local needs_confirmation=false

  touch "$state_root/moved-system.tsv"
  for target in /etc/bashrc /etc/zshrc; do
    backup=$target.before-nix-darwin
    if [[ -L $target ]]; then
      link=$(readlink "$target")
      case $link in
        /etc/static/* | /run/current-system/* | /nix/store/*) continue ;;
        *) die "Unrecognized system shell symbolic link: $target -> $link" ;;
      esac
    fi
    if [[ -e $target ]]; then
      [[ ! -e $backup && ! -L $backup ]] || die "Refusing to overwrite existing backup: $backup"
      ls -ld "$target"
      shasum -a 256 "$target"
      needs_confirmation=true
    elif [[ -e $backup || -L $backup ]]; then
      note "Existing preserved system file: $backup"
    fi
  done

  if $needs_confirmation; then
    confirm "PRESERVE SYSTEM SHELL FILES"
  fi

  for target in /etc/bashrc /etc/zshrc; do
    backup=$target.before-nix-darwin
    if [[ -e $target && ! -L $target ]]; then
      if ! awk -F '\t' -v target="$target" '$1 == target { found = 1 } END { exit !found }' \
        "$state_root/moved-system.tsv"; then
        printf '%s\t%s\n' "$target" "$backup" >>"$state_root/moved-system.tsv"
      fi
      sudo mv "$target" "$backup"
      note "Preserved $target as $backup"
    fi
  done
}

prepare() {
  require_marker audited audit
  [[ ! -f $state_root/restored ]] || die "This migration was restored. Remove the state directory before restarting."
  require_clean_repo
  record_revision
  prepare_work_identity

  if ! command -v brew >/dev/null 2>&1 || \
    { ! command -v nix >/dev/null 2>&1 && [[ ! -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; }; then
    "$root/bin/bootstrap" --apply
  fi
  load_nix
  "$root/bin/check" work

  preview_homebrew_cleanup "$state_root/homebrew-cleanup.prepare.txt"
  confirm "ACCEPT HOMEBREW CLEANUP"
  touch "$state_root/preparing"
  prepare_system_shell_files
  preserve_home_paths

  touch "$state_root/prepared"
  note "Preparation completed. Run bin/migrate-work activate."
}

activate() {
  local active_system

  require_marker prepared prepare
  [[ ! -f $state_root/restored ]] || die "This migration was restored. Remove the state directory before restarting."
  [[ ! -f $state_root/activated ]] || die "Activation already succeeded. Run verify next."
  require_clean_repo
  record_revision
  load_nix

  preview_homebrew_cleanup "$state_root/homebrew-cleanup.activate.txt"
  confirm "ACTIVATE WORK PROFILE"
  if [[ -L /run/current-system ]]; then
    active_system=$(readlink /run/current-system)
  else
    active_system=MISSING
  fi
  printf '%s\n' "$active_system" >"$state_root/system-before-activation"
  touch "$state_root/activation-started"
  "$root/bin/switch" work

  touch "$state_root/activated"
  note "Activation completed. Open a new terminal and run bin/migrate-work verify."
}

verify_mutable_settings() {
  local expected_hash path actual_hash
  while IFS=$'\t' read -r expected_hash path; do
    if [[ -f $path ]]; then
      actual_hash=$(shasum -a 256 "$path" | awk '{ print $1 }')
    else
      actual_hash=MISSING
    fi
    [[ $actual_hash == "$expected_hash" ]] || die "Mutable setting changed during migration: $path"
  done <"$state_root/mutable-settings.before.tsv"
}

verify_command_provider() {
  local executable=$1
  local provider
  provider=$(command -v "$executable" || true)
  [[ -n $provider ]] || die "Expected command is unavailable: $executable"
  case $provider in
    /etc/profiles/per-user/cyakimov/* | /run/current-system/* | /nix/store/*) ;;
    *) die "$executable is not resolving through Nix: $provider" ;;
  esac
}

verify() {
  local expected_system active_system command_path

  require_marker activated activate
  require_clean_repo
  record_revision
  load_nix
  "$root/bin/check" work

  expected_system=$(nix --extra-experimental-features "nix-command flakes" \
    build --no-link --print-out-paths --no-write-lock-file \
    "$root#darwinConfigurations.work.system")
  [[ -L /run/current-system ]] || die "/run/current-system is not active."
  active_system=$(readlink /run/current-system)
  [[ $active_system == "$expected_system" ]] || \
    die "The active system does not match the checked work configuration."

  if nix-store -qR "$expected_system" | grep -qi herdr; then
    die "Herdr is present in the work system closure."
  fi
  [[ ! -e $HOME/.config/herdr && ! -L $HOME/.config/herdr ]] || \
    die "Herdr configuration remains in the work home."

  for command_path in gh go node cargo rustc bun; do
    verify_command_provider "$command_path"
  done
  /bin/zsh -lic '(( ! $+commands[mise] && ! $+commands[herdr] && ! $+functions[_mise_hook] ))' || \
    die "A fresh Zsh login still exposes Mise or Herdr."

  validate_work_identity
  git config --global --get-regexp '^includeif\..*\.path$' | \
    grep -Fq '.config/git/work.inc' || die "The conditional work Git include is not active."
  verify_mutable_settings

  generate_brewfile
  brew bundle check --file="$brewfile"
  brew bundle cleanup --file="$brewfile" >"$state_root/homebrew-cleanup.verify.txt" 2>&1
  if grep -Eqi 'would (uninstall|remove)|brew (uninstall|remove|rm)' "$state_root/homebrew-cleanup.verify.txt"; then
    cat "$state_root/homebrew-cleanup.verify.txt"
    die "Homebrew still has undeclared removable packages."
  fi

  touch "$state_root/verified"
  note "The work configuration is verified. Run bin/migrate-work cleanup when ready."
}

add_deletion() {
  local path=$1
  local reason=$2
  local replacement=$3
  if [[ -e $path || -L $path ]]; then
    printf '%s\t%s\t%s\n' "$path" "$reason" "$replacement" >>"$state_root/deletion-manifest.tsv"
  fi
}

safe_deletion_target() {
  case $1 in
    "$HOME"/.config/mise|"$HOME"/.local/share/mise|"$HOME"/.local/state/mise) return 0 ;;
    "$HOME"/.cache/mise|"$HOME"/.asdf|"$HOME"/.rtx|"$HOME"/.nvm) return 0 ;;
    "$HOME"/.rbenv|"$HOME"/.pyenv|"$HOME"/.nodenv|"$HOME"/.local/pipx) return 0 ;;
    "$HOME"/.local/share/pipx|"$HOME"/.cache/pipx|"$HOME"/.bun/install/cache) return 0 ;;
    "$HOME"/.cargo/registry|"$HOME"/.cargo/git|"$HOME"/.config/herdr) return 0 ;;
    "$HOME"/.local/bin/mise|"$HOME"/.local/bin/herdr) return 0 ;;
    *) return 1 ;;
  esac
}

cleanup_legacy() {
  local path reason replacement count

  require_marker verified verify
  require_clean_repo
  record_revision

  : >"$state_root/deletion-manifest.tsv"
  add_deletion "$HOME/.config/mise" "Legacy Mise configuration" "Nix work profile"
  add_deletion "$HOME/.local/share/mise" "Legacy Mise tools" "Nix work profile and intentional retirement"
  add_deletion "$HOME/.local/state/mise" "Legacy Mise state" "Nix work profile"
  add_deletion "$HOME/.cache/mise" "Legacy Mise cache" "Recreatable cache"
  add_deletion "$HOME/.asdf" "Legacy asdf manager" "Nix work profile and intentional retirement"
  add_deletion "$HOME/.rtx" "Legacy rtx manager" "Nix work profile and intentional retirement"
  add_deletion "$HOME/.nvm" "Legacy Node manager" "Nix nodejs"
  add_deletion "$HOME/.rbenv" "Legacy Ruby manager" "Nix ruby"
  add_deletion "$HOME/.pyenv" "Legacy Python manager" "Nix python"
  add_deletion "$HOME/.nodenv" "Legacy Node manager" "Nix nodejs"
  add_deletion "$HOME/.local/pipx" "Legacy pipx applications" "Nix work profile and intentional retirement"
  add_deletion "$HOME/.local/share/pipx" "Legacy pipx applications" "Nix work profile and intentional retirement"
  add_deletion "$HOME/.cache/pipx" "Legacy pipx cache" "Recreatable cache"
  add_deletion "$HOME/.bun/install/cache" "Legacy Bun cache" "Recreatable cache"
  add_deletion "$HOME/.cargo/registry" "Legacy Cargo registry cache" "Recreatable cache"
  add_deletion "$HOME/.cargo/git" "Legacy Cargo Git cache" "Recreatable cache"
  add_deletion "$HOME/.config/herdr" "Herdr is forbidden at work" "No replacement"
  add_deletion "$HOME/.local/bin/mise" "Legacy Mise executable" "Nix work profile"
  add_deletion "$HOME/.local/bin/herdr" "Herdr is forbidden at work" "No replacement"

  count=$(wc -l <"$state_root/deletion-manifest.tsv" | tr -d ' ')
  if (( count == 0 )); then
    note "No allowlisted legacy paths remain."
    touch "$state_root/cleaned"
    return 0
  fi

  note "Permanent deletion manifest:"
  awk -F '\t' '{ printf "  %s\n    reason: %s\n    replacement: %s\n", $1, $2, $3 }' \
    "$state_root/deletion-manifest.tsv"
  note "Project-level Mise files, Cargo credentials, .npmrc, and unknown ~/.local/bin entries are excluded."
  confirm "DELETE $count LEGACY PATHS"

  while IFS=$'\t' read -r path reason replacement; do
    safe_deletion_target "$path" || die "Unsafe deletion target in manifest: $path"
    [[ -e $path || -L $path ]] || continue
    /bin/rm -rf -- "$path"
    note "Deleted $path"
  done <"$state_root/deletion-manifest.tsv"

  if [[ -d $HOME/.local/bin && ! -L $HOME/.local/bin ]] && \
    [[ -z $(find "$HOME/.local/bin" -mindepth 1 -maxdepth 1 -print -quit) ]]; then
    rmdir "$HOME/.local/bin"
    note "Removed empty $HOME/.local/bin"
  fi

  touch "$state_root/cleaned"
  note "Legacy cleanup completed. Migration backups remain at $backup_root"
}

restore() {
  local target backup mode restored_directory key active_system previous_system

  [[ -f $state_root/preparing || -f $state_root/prepared ]] || \
    die "No preserved migration state is available to restore."
  [[ ! -f $state_root/activated ]] || \
    die "Activation succeeded. Roll back nix-darwin before attempting a legacy restore."
  if [[ -f $state_root/activation-started ]]; then
    previous_system=$(<"$state_root/system-before-activation")
    if [[ -L /run/current-system ]]; then
      active_system=$(readlink /run/current-system)
    else
      active_system=MISSING
    fi
    [[ $active_system == "$previous_system" ]] || \
      die "The active system changed. Roll back nix-darwin before restoring legacy files."
  fi

  if [[ -s $state_root/moved-home.tsv ]]; then
    while IFS=$'\t' read -r target backup mode; do
      [[ -e $backup || -L $backup ]] || continue
      if [[ $mode == unfolded ]]; then
        [[ -d $target && ! -L $target ]] || die "Cannot preserve the unfolded directory before restore: $target"
      else
        [[ ! -e $target && ! -L $target ]] || die "Refusing to overwrite during restore: $target"
      fi
    done <"$state_root/moved-home.tsv"
  fi
  if [[ -s $state_root/moved-system.tsv ]]; then
    while IFS=$'\t' read -r target backup; do
      [[ -e $backup || -L $backup ]] || continue
      [[ ! -e $target && ! -L $target ]] || die "Refusing to overwrite during restore: $target"
    done <"$state_root/moved-system.tsv"
  fi

  if [[ -s $state_root/moved-home.tsv ]]; then
    while IFS=$'\t' read -r target backup mode; do
      [[ -e $backup || -L $backup ]] || continue
      mkdir -p "$(dirname -- "$target")"
      if [[ $mode == unfolded ]]; then
        [[ -d $target && ! -L $target ]] || die "Cannot preserve the unfolded directory before restore: $target"
        key=$(backup_key "$target")
        restored_directory=$state_root/unfolded-after-prepare/$key
        [[ ! -e $restored_directory && ! -L $restored_directory ]] || \
          die "Restore holding path already exists: $restored_directory"
        mkdir -p "$(dirname -- "$restored_directory")"
        mv "$target" "$restored_directory"
      else
        [[ ! -e $target && ! -L $target ]] || die "Refusing to overwrite during restore: $target"
      fi
      mv "$backup" "$target"
      note "Restored $target"
    done < <(tail -r "$state_root/moved-home.tsv")
  fi

  if [[ -s $state_root/moved-system.tsv ]]; then
    while IFS=$'\t' read -r target backup; do
      [[ -e $backup || -L $backup ]] || continue
      [[ ! -e $target && ! -L $target ]] || die "Refusing to overwrite during restore: $target"
      sudo mv "$backup" "$target"
      note "Restored $target"
    done < <(tail -r "$state_root/moved-system.tsv")
  fi

  touch "$state_root/restored"
  note "Legacy files were restored. Remove $state_root before starting a new migration."
}

case $command_name in
  audit) audit ;;
  prepare) prepare ;;
  activate) activate ;;
  verify) verify ;;
  cleanup) cleanup_legacy ;;
  restore) restore ;;
esac
