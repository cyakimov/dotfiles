#!/usr/bin/env bash

set -euo pipefail

apply=false
case ${1:-} in
  "") ;;
  --apply) apply=true ;;
  *) printf 'error: Usage: bin/bootstrap [--apply]\n' >&2; exit 1 ;;
esac

[[ $(uname -s) == "Darwin" && $(uname -m) == "arm64" ]] || {
  printf 'error: This repository currently supports Apple Silicon macOS only.\n' >&2
  exit 1
}

printf '%s\n' "Bootstrap installs Homebrew and multi-user Nix when they are missing."
printf '%s\n' "It does not activate a system configuration."

if ! $apply; then
  printf '%s\n' "Dry run only. Re-run with --apply to install missing prerequisites."
  exit 0
fi

free_kib=$(df -Pk / | awk 'NR == 2 { print $4 }')
[[ $free_kib =~ ^[0-9]+$ ]] || {
  printf 'error: Could not determine available disk space.\n' >&2
  exit 1
}
(( free_kib >= 20971520 )) || {
  printf 'error: At least 20 GiB of free disk space is required.\n' >&2
  exit 1
}

command -v curl >/dev/null 2>&1 || {
  printf 'error: curl is required.\n' >&2
  exit 1
}

temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-bootstrap.XXXXXX")
cleanup_temp() {
  /bin/rm -f "$temp_dir/homebrew-install.sh" "$temp_dir/nix-install.sh"
  /bin/rmdir "$temp_dir" 2>/dev/null || true
}
trap cleanup_temp EXIT

if command -v brew >/dev/null 2>&1; then
  printf 'Homebrew is already installed: %s\n' "$(command -v brew)"
else
  curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$temp_dir/homebrew-install.sh"
  /bin/bash "$temp_dir/homebrew-install.sh"
fi

if ! command -v nix >/dev/null 2>&1 && [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  set +u
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  set -u
fi

if command -v nix >/dev/null 2>&1; then
  printf 'Nix is already installed: %s\n' "$(command -v nix)"
else
  curl -fsSL https://nixos.org/nix/install -o "$temp_dir/nix-install.sh"
  /bin/sh "$temp_dir/nix-install.sh" --daemon
fi

printf '%s\n' "Bootstrap completed. Open a new shell, then run bin/check."
