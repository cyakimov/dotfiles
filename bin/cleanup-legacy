#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

apply=false
case ${1:-} in
  "") ;;
  --apply) apply=true ;;
  *) die "Usage: bin/cleanup-legacy [--apply]" ;;
esac

require_apple_silicon_macos

activated_file=$DOTFILES_STATE_ROOT/current/activated-at
[[ -f $activated_file ]] || die "No successful migration activation is recorded."
activated_epoch=$(sed -n '1p' "$activated_file")
[[ $activated_epoch =~ ^[0-9]+$ ]] || die "The recorded activation timestamp is invalid."
age_days=$(age_in_days "$activated_epoch")
(( age_days >= 30 )) || die "Legacy cleanup is locked for 30 days. Current proving period: $age_days day(s)."

project_config=$(find_project_mise_config || true)

keep_mise_data=false
if [[ -n $project_config ]]; then
  keep_mise_data=true
  warn "Project-local tool configuration found: $project_config"
  warn "Global Mise entries will be retired, but project data will be preserved for Nix-provided Mise."
fi

say "Verifying replacement commands before cleanup..."
while IFS=$'\t' read -r provider command_name; do
  [[ -n ${provider:-} && $provider != \#* ]] || continue
  command -v "$command_name" >/dev/null 2>&1 || die "Replacement command is missing: $command_name"
  command_path=$(command -v "$command_name")

  if [[ $provider == "nix" ]]; then
    is_nix_owned_path "$command_path" || die "$command_name is not provided by Nix: $command_path"
  elif [[ $command_path != /opt/homebrew/* ]]; then
    die "$command_name is not provided by Homebrew: $command_path"
  fi
done < "$DOTFILES_ROOT/migration/replacement-commands.tsv"

docker compose version >/dev/null 2>&1 || die "The Nix-managed Docker Compose CLI plugin is unavailable."

say "Replacement verification passed."
say "The cleanup will only target the old global Mise entries and formulae listed in migration/homebrew-formulae.txt."
$keep_mise_data && say "Mise data will be retained for project-local configurations."

if ! $apply; then
  say "Dry run only. No tools or files were removed."
  exit 0
fi

require_command brew
require_command jq

cleanup_id=$(timestamp_utc)
retired_dir=$DOTFILES_STATE_ROOT/retired/$cleanup_id
mkdir -p "$retired_dir"

legacy_mise_config=$HOME/.config/mise/config.toml
if command -v mise >/dev/null 2>&1 && [[ -f $legacy_mise_config ]]; then
  cp -p "$legacy_mise_config" "$retired_dir/mise-config.toml"
  mise_json=$(MISE_GLOBAL_CONFIG_FILE="$legacy_mise_config" mise ls --global --json)

  while IFS= read -r tool; do
    [[ -n $tool && $tool != \#* ]] || continue
    requested=$(printf '%s\n' "$mise_json" | jq -r --arg tool "$tool" '.[$tool][]? | select(.installed == true) | .requested_version' | sed -n '1p')
    if [[ -n $requested && $requested != "null" ]]; then
      MISE_GLOBAL_CONFIG_FILE="$legacy_mise_config" mise unuse --global --no-prune --yes "$tool@$requested"
    fi
  done < "$DOTFILES_ROOT/migration/mise-tools.txt"

  if [[ -f $legacy_mise_config ]]; then
    mv "$legacy_mise_config" "$retired_dir/mise-config.after-unuse.toml"
  fi
fi

while IFS= read -r formula; do
  [[ -n $formula && $formula != \#* ]] || continue
  if brew list --formula "$formula" >/dev/null 2>&1; then
    HOMEBREW_NO_AUTO_UPDATE=1 brew uninstall "$formula"
  fi
done < "$DOTFILES_ROOT/migration/homebrew-formulae.txt"

epoch_now > "$DOTFILES_STATE_ROOT/current/cleaned-at"
printf '%s\n' "$retired_dir" > "$DOTFILES_STATE_ROOT/current/retired-backup"

say "Managed legacy tools were cleaned up."
say "Mise data and caches were retained for at least another 30 days."
say "Unrelated Homebrew packages and all casks were left untouched."
