#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
[[ $# -eq 1 ]] || {
  printf 'error: Usage: bin/switch <personal|work>\n' >&2
  exit 1
}
host=${1:-}
case $host in
  personal | work) ;;
  *) printf 'error: Usage: bin/switch <personal|work>\n' >&2; exit 1 ;;
esac

[[ $(uname -s) == "Darwin" && $(uname -m) == "arm64" ]] || {
  printf 'error: This repository currently supports Apple Silicon macOS only.\n' >&2
  exit 1
}
[[ -z $(git -C "$root" status --porcelain --untracked-files=normal) ]] || {
  printf 'error: Refusing to activate a dirty checkout.\n' >&2
  exit 1
}

if ! command -v nix >/dev/null 2>&1 && [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  set +u
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  set -u
fi
command -v nix >/dev/null 2>&1 || {
  printf 'error: Nix is not available.\n' >&2
  exit 1
}

"$root/bin/check" "$host"
system_path=$(nix --extra-experimental-features "nix-command flakes" \
  build --no-link --print-out-paths "$root#darwinConfigurations.$host.system")
rebuild=$system_path/sw/bin/darwin-rebuild
[[ -x $rebuild ]] || {
  printf 'error: The built system does not contain darwin-rebuild.\n' >&2
  exit 1
}

if ! tmutil localsnapshot >/dev/null 2>&1; then
  printf 'error: Could not create a local Time Machine snapshot.\n' >&2
  exit 1
fi
printf '%s\n' "Created a local Time Machine snapshot."

sudo -H "$rebuild" switch --flake "$root#$host"

printf 'Activated the %s configuration. Open a new terminal before verification.\n' "$host"
