#!/usr/bin/env bash

set -euo pipefail

apply=false
case ${1:-} in
  "") ;;
  --apply) apply=true ;;
  *) printf 'error: Usage: bin/update [--apply]\n' >&2; exit 1 ;;
esac

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
if ! command -v nix >/dev/null 2>&1 && [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  set +u
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  set -u
fi
command -v nix >/dev/null 2>&1 || {
  printf 'error: Nix is not available.\n' >&2
  exit 1
}

if ! $apply; then
  printf '%s\n' "Dry run only. Re-run with --apply to update flake.lock and check both hosts."
  exit 0
fi
[[ -z $(git -C "$root" status --porcelain --untracked-files=normal) ]] || {
  printf 'error: Refusing to update a dirty checkout.\n' >&2
  exit 1
}

temporary_lock=$root/.flake.lock.before-update.$$
cp -p "$root/flake.lock" "$temporary_lock"
restore_lock() {
  mv "$temporary_lock" "$root/flake.lock"
  printf 'warning: Update failed; restored the previous lock file.\n' >&2
}
trap restore_lock EXIT

nix --extra-experimental-features "nix-command flakes" flake update --flake "$root"
"$root/bin/check"
/bin/rm -f "$temporary_lock"
trap - EXIT

printf '%s\n' "Updated flake.lock and checked both host configurations."
