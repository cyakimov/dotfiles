#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

apply=false
case ${1:-} in
  "") ;;
  --apply) apply=true ;;
  *) die "Usage: bin/purge-legacy [--apply]" ;;
esac

require_apple_silicon_macos

cleaned_file=$DOTFILES_STATE_ROOT/current/cleaned-at
[[ -f $cleaned_file ]] || die "Legacy cleanup has not completed."
cleaned_epoch=$(sed -n '1p' "$cleaned_file")
[[ $cleaned_epoch =~ ^[0-9]+$ ]] || die "The recorded cleanup timestamp is invalid."
age_days=$(age_in_days "$cleaned_epoch")
(( age_days >= 30 )) || die "Legacy data purge is locked for 30 days after cleanup. Current age: $age_days day(s)."

project_config=$(find_project_mise_config || true)
[[ -z $project_config ]] || die "Mise-compatible project configuration still exists: $project_config"

trash_dir=$HOME/.Trash/dotfiles-mise-$(timestamp_utc)
say "The following legacy Mise directories will be moved to: $trash_dir"

index=0
for path in \
  "$HOME/.local/share/mise" \
  "$HOME/.local/state/mise" \
  "$HOME/Library/Caches/mise" \
  "$HOME/.cache/mise" \
  "$HOME/.config/mise"; do
  if [[ -e $path ]]; then
    printf '  %s\n' "$path"
    index=$((index + 1))
  fi
done

if (( index == 0 )); then
  say "No legacy Mise directories remain."
  exit 0
fi

if ! $apply; then
  say "Dry run only. Nothing was moved."
  exit 0
fi

mkdir -p "$trash_dir"

move_if_present() {
  local source=$1
  local destination=$2
  [[ -e $source ]] || return
  mv "$source" "$trash_dir/$destination"
}

move_if_present "$HOME/.local/share/mise" data
move_if_present "$HOME/.local/state/mise" state
move_if_present "$HOME/Library/Caches/mise" library-cache
move_if_present "$HOME/.cache/mise" xdg-cache
move_if_present "$HOME/.config/mise" config

say "Legacy Mise data was moved to the Trash and remains recoverable until the Trash is emptied."
