#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

[[ $# -eq 0 ]] || die "Usage: bin/verify"

say "Checking Bash syntax..."
while IFS= read -r script; do
  bash -n "$script"
done < <(find "$DOTFILES_ROOT/bin" "$DOTFILES_ROOT/tests" -type f -print | LC_ALL=C sort)

if command -v shellcheck >/dev/null 2>&1; then
  say "Running ShellCheck..."
  # shellcheck disable=SC2046
  shellcheck -x -P "$DOTFILES_ROOT" $(find "$DOTFILES_ROOT/bin" "$DOTFILES_ROOT/tests" -type f -print | LC_ALL=C sort)
else
  warn "ShellCheck is unavailable, so shell linting was skipped."
fi

require_command jq
say "Validating JSON templates and configuration..."
while IFS= read -r json_file; do
  jq empty "$json_file"
done < <(find "$DOTFILES_ROOT/config" "$DOTFILES_ROOT/templates" -type f -name '*.json' -print | LC_ALL=C sort)

if command -v python3 >/dev/null 2>&1; then
  say "Validating TOML files..."
  while IFS= read -r toml_file; do
    python3 -c 'import pathlib, sys, tomllib; tomllib.loads(pathlib.Path(sys.argv[1]).read_text())' "$toml_file"
  done < <(find "$DOTFILES_ROOT/config" "$DOTFILES_ROOT/templates" -type f -name '*.toml' -print | LC_ALL=C sort)
else
  warn "Python 3 is unavailable, so TOML parsing was skipped."
fi

say "Running migration safety tests..."
"$DOTFILES_ROOT/tests/audit.sh"
"$DOTFILES_ROOT/tests/activation.sh"
"$DOTFILES_ROOT/tests/cleanup.sh"
"$DOTFILES_ROOT/tests/manifests.sh"
"$DOTFILES_ROOT/tests/recovery.sh"

load_nix_environment
if command -v nix-instantiate >/dev/null 2>&1; then
  say "Parsing Nix expressions..."
  while IFS= read -r nix_file; do
    nix-instantiate --parse "$nix_file" >/dev/null
  done < <(find "$DOTFILES_ROOT" -type f -name '*.nix' -print | LC_ALL=C sort)
else
  warn "Nix is unavailable, so Nix parsing and evaluation were skipped."
fi

say "Static verification completed."
