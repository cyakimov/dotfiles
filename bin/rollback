#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=bin/lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

apply=false
mode=system
backup_dir=

while [[ $# -gt 0 ]]; do
  case $1 in
    --apply) apply=true ;;
    --system) mode=system ;;
    --legacy-files) mode=legacy ;;
    --legacy-links) mode=links ;;
    --backup)
      [[ $# -ge 2 ]] || die "--backup requires a directory."
      backup_dir=$2
      shift
      ;;
    *) die "Usage: bin/rollback [--apply] [--system | --legacy-files | --legacy-links] [--backup DIR]" ;;
  esac
  shift
done

require_apple_silicon_macos

if [[ $mode == "system" ]]; then
  say "Rollback target: the previous nix-darwin system generation."
  if ! $apply; then
    say "Dry run only. Re-run with --apply to execute darwin-rebuild switch --rollback."
    exit 0
  fi

  require_command darwin-rebuild
  sudo -H "$(command -v darwin-rebuild)" switch --rollback
  say "The previous nix-darwin generation is active."
  exit 0
fi

if [[ -z $backup_dir ]]; then
  backup_dir=$(latest_backup_dir) || die "No migration backup was found."
fi
[[ -f $backup_dir/links.tsv ]] || die "Invalid migration backup: $backup_dir"

if [[ $mode == "links" ]]; then
  say "Exact legacy topology restore from: $backup_dir"
  if ! $apply; then
    say "Dry run only. Re-run with --legacy-links --apply to restore recorded file and folded-directory links."
    exit 0
  fi

  restore_legacy_topology "$backup_dir" || die "Exact legacy topology recovery was incomplete."
  say "The recorded pre-activation home topology was restored."
  exit 0
fi

say "Emergency file restore from: $backup_dir"
while IFS=$'\t' read -r entry_mode relative _; do
  [[ $entry_mode == "managed" ]] || continue
  target=$HOME/$relative
  printf 'restore %s\n' "$target"
done < "$backup_dir/links.tsv"

if ! $apply; then
  say "Dry run only. Re-run with --legacy-files --apply to replace Nix-owned links with regular backup files."
  exit 0
fi

while IFS= read -r relative; do
  [[ -n $relative && $relative != \#* ]] || continue
  target=$HOME/$relative
  if [[ -L $target ]] && is_nix_owned_path "$target"; then
    unlink "$target"
  fi
done < "$DOTFILES_ROOT/migration/home-manager-targets.txt"

while IFS=$'\t' read -r entry_mode relative _; do
  [[ $entry_mode == "managed" ]] || continue
  target=$HOME/$relative
  source_file=$backup_dir/files/$relative
  [[ -f $source_file ]] || die "Backup file is missing: $source_file"

  if [[ -L $target ]]; then
    is_nix_owned_path "$target" || die "Refusing to replace a foreign symlink: $target"
    unlink "$target"
  elif [[ -e $target ]]; then
    die "Refusing to replace a regular path: $target"
  fi

  mkdir -p "$(dirname "$target")"
  cp -p "$source_file" "$target"
done < "$backup_dir/links.tsv"

say "Emergency files restored as regular files."
say "The nix-darwin system generation was not changed."
say "Use this only to regain a working shell, then diagnose before another switch."
