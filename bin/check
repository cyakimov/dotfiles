#!/usr/bin/env bash

set -euo pipefail

[[ $# -le 1 ]] || {
  printf 'error: Usage: bin/check [personal|work]\n' >&2
  exit 1
}
profile=${1:-}
case $profile in
  "" | personal | work) ;;
  *) printf 'error: Usage: bin/check [personal|work]\n' >&2; exit 1 ;;
esac

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
if ! command -v nix >/dev/null 2>&1 && [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  set +u
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  set -u
fi

command -v nix >/dev/null 2>&1 || {
  printf 'error: Nix is not available. Open a new shell after bootstrap.\n' >&2
  exit 1
}
[[ -f $root/flake.lock ]] || {
  printf 'error: flake.lock is required.\n' >&2
  exit 1
}

if [[ -z $profile ]]; then
  nix --extra-experimental-features "nix-command flakes" \
    flake check --no-write-lock-file "$root"
else
  nix --extra-experimental-features "nix-command flakes" \
    build --no-link --no-write-lock-file \
    "$root#checks.aarch64-darwin.static" \
    "$root#checks.aarch64-darwin.$profile"
fi
